    {
      "name": "get  iteration",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = res.body;",
              "",
              "if (!body?._embedded?.[\"test-plan\"]) {",
              "  throw new Error(\"Response does not contain test-plan data\");",
              "}",
              "",
              "const testPlans = body._embedded[\"test-plan\"];",
              "const summary = {};",
              "",
              "testPlans.forEach(item => {",
              "  const status = item.execution_status || \"UNKNOWN\";",
              "  const testCase = item.referenced_test_case;",
              "",
              "  if (!summary[status]) {",
              "    summary[status] = {",
              "      total: 0,",
              "      testCases: []",
              "    };",
              "  }",
              "",
              "  summary[status].total += 1;",
              "  summary[status].testCases.push({",
              "    id: testCase?.id,",
              "    name: testCase?.name",
              "  });",
              "});",
              "",
              "console.log(\"===== TEST PLAN SUMMARY =====\");",
              "",
              "Object.keys(summary).forEach(status => {",
              "  console.log(\"\");",
              "  console.log(\"Status:\", status);",
              "  console.log(\"Total:\", summary[status].total);",
              "",
              "  summary[status].testCases.forEach(tc => {",
              "    console.log(`- TestCaseId: ${tc.id} | Name: ${tc.name}`);",
              "  });",
              "});",
              "",
              "// Lưu env nếu cần dùng tiếp",
              "bru.setEnvVar(",
              "  \"testplan_summary\",",
              "  JSON.stringify(summary)",
              ");",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "undefined",
              "type": "any"
            }
          ]
        },
